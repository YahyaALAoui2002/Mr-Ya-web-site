{
  "name": "mrye-web-site",
  "version": "21.0.0",
  "private": true,
  "description": "Mr Ye 幸福食光: one-page restaurant site with a real-time 3D bubble tea builder (Three.js r159, no framework, no bundler)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:debug": "node build.mjs --debug",
    "serve": "python3 -m http.server 8080 --directory dist",
    "test": "node build.mjs --debug && python3 tests/run_all.py",
    "test:fast": "node build.mjs --debug && python3 tests/run_all.py --fast"
  }
}
